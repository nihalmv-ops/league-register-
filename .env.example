# Football League Management & Live Player Auction System
# Root Environment Template

# ================================
# Backend Server Configuration
# ================================
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/football_league

# Client Origin (CORS whitelist)
CLIENT_URL=http://localhost:5173

# Logging Verbosity: error | warn | info | debug
LOG_LEVEL=debug

# ================================
# Frontend Client Configuration
# ================================
# In local development, leave /api so Vite reverse-proxy forwards to backend
VITE_API_URL=/api
