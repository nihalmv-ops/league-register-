# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/football_league

# Allowed Frontend Origins (CORS)
CLIENT_URL=http://localhost:5173
PLAYER_REGISTRATION_URL=http://localhost:5174

# JWT Authentication Secret
JWT_SECRET=super_secret_football_league_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Default Initial Administrator Credentials (auto-seeded if not existing)
ADMIN_EMAIL=admin@football.league
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=League Commissioner

# Cloudinary Storage Configuration
# Sign up at https://cloudinary.com for free credentials
# Leave empty to use automatic local uploads fallback (/uploads/players)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Logging Level: error | warn | info | debug
LOG_LEVEL=debug
